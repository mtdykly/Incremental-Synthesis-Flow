

# =====================
# Base
# =====================

read_verilog /workspace/Incremental-Synthesis-Flow/results/eco-001/base/design.v

prep -top riscv_core

flatten

rename riscv_core base

design -stash gold



# =====================
# Reset
# =====================

design -reset



# =====================
# New
# =====================

read_verilog /workspace/Incremental-Synthesis-Flow/results/eco-001/new/design.v

prep -top riscv_core

flatten

rename riscv_core new

design -stash gate



# =====================
# Restore
# =====================

design -copy-from gold -as base base

design -copy-from gate -as new new


# =====================
# Equiv
# =====================

equiv_make base new equiv

prep -top equiv

equiv_simple

equiv_status

